ASEPRITE_PATH=/path/to/aseprite

# Command timeout, including time waiting for an execution slot (maximum 300).
ASEPRITE_TIMEOUT_SECONDS=30

# Optional: restrict all tool paths to this directory; disables unrestricted Lua.
# Font files must also be inside this root when it is configured.
# ASEPRITE_WORKSPACE_ROOT=/path/to/artwork

# --- Optional: Install Aseprite from Steam within container ---
# Provide these to enable runtime install using SteamCMD.
# WARNING: Prefer using `docker run --env-file` or secrets; do not bake credentials.
# STEAM_USERNAME=your_steam_username
# STEAM_PASSWORD=your_steam_password
# If Steam Guard is enabled:
# STEAM_GUARD_CODE=XXXXX
# Optional overrides:
# STEAM_APPID=431730
# STEAM_INSTALL_DIR=/opt/steamapps
